+def _fuzzy_catalog_models(q_raw, idx):
+    """Find conservative near-identities in the catalog.
+
+    Catalog references may omit one leading SKU character or contain one
+    character typo.  Only structured identifiers of at least four characters
+    are eligible; short numeric fragments never become catalog identities.
+    """
+    q = normalize(q_raw)
+    if len(q) < 4 or q.isdigit():
+        return []
+    matches = []
+    for model in idx["models"]:
+        identifiers = {normalize(model.get("sku", ""))}
+        identifiers |= {normalize(a) for a in (model.get("aliases", []) or [])}
+        identifiers.discard("")
+        for ident in identifiers:
+            omitted_leading = len(ident) == len(q) + 1 and ident.endswith(q)
+            one_edit = len(ident) == len(q) and _damerau_levenshtein(q, ident) <= 1
+            if omitted_leading or one_edit:
+                matches.append(model)
+                break
+    return _dedupe_models(matches)
+
+
 def _devices_for_models(models, devices):
     skus = {normalize(m.get("sku", "")) for m in models}
     skus.discard("")
     return _dedupe([d for d in devices if normalize(d.get("sku", "")) in skus])
 
 
+def _dedupe_models(models):
+    seen = set()
+    out = []
+    for model in models:
+        key = normalize(model.get("sku", "")) or normalize(model.get("canonical_name", ""))
+        if key and key not in seen:
+            seen.add(key)
+            out.append(model)
+    return out
+
+
+def _model_port_count(model):
+    text = str(model.get("model", "")).lower()
+    matches = re.findall(r"-(\d+)(?:g)?(?:-|$)", text)
+    return int(matches[-1]) if matches else None
+
+
+def _facet_filtered_models(q_raw, idx):
+    """Apply explicit natural-language catalog facets.
+
+    Returns None when the query contains no supported facet, allowing the
+    existing metadata matcher to handle ordinary model-name queries.
+    """
+    text = str(q_raw or "").lower().replace("ı", "i")
+    negative_poe = bool(re.search(
+        r"(?:non\s*-?\s*poe|poe\s*(?:olmayan|siz|suz|yok)|poe['’]?siz)", text
+    ))
+    has_poe = "poe" in text
+    positive_poe = has_poe and not negative_poe
+    port_match = re.search(
+        r"\b(\d+)\s*[-]?\s*(?:tane\s+)?port(?:u|lu|lar[ıi]?|\s+olan)?\b", text
+    )
+    if not port_match:
+        port_match = re.search(r"\b(\d+)\s*g\b", text)
+    port_count = int(port_match.group(1)) if port_match else None
+    brand = "procurve" in text or "hp" in text
+    family_tokens = [token for token in _TOKEN_RE.findall(text) if token.isdigit() and len(token) >= 3]
+    if not (negative_poe or positive_poe or port_count is not None or brand):
+        return None
+
+    models = []
+    for model in idx["models"]:
+        model_text = " ".join(str(model.get(k, "")) for k in ("brand", "model", "canonical_name", "search_text", "aliases")).lower()
+        model_is_poe = "poe" in model_text
+        if brand and "procurve" not in model_text and "hp" not in model_text:
+            continue
+        if family_tokens and not all(token in model_text for token in family_tokens):
+            continue
+        if port_count is not None and _model_port_count(model) != port_count:
+            continue
+        if negative_poe and model_is_poe:
+            continue
+        if positive_poe and not model_is_poe:
+            continue
+        models.append(model)
+    return _dedupe_models(models)
+
+
