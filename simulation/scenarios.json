      "expected_api_evidence": [
        {"resource": "device_ports", "selector": {"ifIndex": 4}}
      ],
      "example_questions": ["lab-j9772a-01 cihazında Demo-Uplink açıklamalı port hangisi?"],
      "expected_answer_semantics": ["port_identity", "port_alias"],
      "reset_state": "baseline"
    },
    {
      "id": "location-change",
      "name": "Cihaz konumunu değiştir",
