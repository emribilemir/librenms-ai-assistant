{
  "version": 1,
  "targets": [
    {
      "id": "lab-j9772a-01",
      "hostname": "lab-j9772a-01",
      "agent_address": "127.0.0.11",
      "agent_port": 1611,
      "fixture": "lab-j9772a-01",
      "baseline_active": true,
      "capabilities": ["device", "ports", "location", "uptime", "events"]
    },
    {
      "id": "lab-j9775a-01",
      "hostname": "lab-j9775a-01",
      "agent_address": "127.0.0.13",
      "agent_port": 1611,
      "fixture": "lab-j9775a-01",
      "baseline_active": false,
      "capabilities": ["device", "reachability"]
    }
  ],
  "scenarios": [
    {
      "id": "device-up-to-down",
      "name": "Cihaz erişimini kapat",
      "description": "Erişilebilir bir cihazın LibreNMS tarafından down görülmesini doğrular.",
      "device": "lab-j9772a-01",
      "precondition": "Cihaz endpointi başlangıçta aktiftir.",
      "mutation": {"kind": "endpoint_membership", "active": false},
      "expected_snmp": [
        {"semantic": "endpointReachable", "index": null, "value": false}
      ],
      "poll_mode": "poller",
      "expected_librenms_surface": [
        {"kind": "device", "status": "down", "reachable": false}
      ],
      "expected_api_evidence": [
        {"resource": "device", "selector": {"hostname": "lab-j9772a-01"}}
      ],
      "example_questions": ["lab-j9772a-01 cihazı şu anda erişilebilir mi?"],
      "expected_answer_semantics": ["device_identity", "device_down", "reachability"],
      "reset_state": "baseline"
    },
    {
      "id": "device-down-to-up",
      "name": "Cihaz erişimini aç",
      "description": "Başlangıçta kapalı bir simülasyon endpointinin discovery ve poller sonrasında görünmesini doğrular.",
      "device": "lab-j9775a-01",
      "precondition": "Cihaz endpointi başlangıçta aktif değildir.",
      "mutation": {"kind": "endpoint_membership", "active": true},
      "expected_snmp": [
        {"semantic": "sysName", "index": null, "value": "lab-j9775a-01"}
      ],
      "poll_mode": "discovery_then_poller",
      "expected_librenms_surface": [
        {"kind": "device", "status": "up", "reachable": true}
      ],
      "expected_api_evidence": [
        {"resource": "device", "selector": {"hostname": "lab-j9775a-01"}}
      ],
      "example_questions": ["lab-j9775a-01 cihazı tekrar online oldu mu?"],
      "expected_answer_semantics": ["device_identity", "device_up", "reachability"],
      "reset_state": "baseline"
    },
    {
      "id": "port-admin-up-oper-up",
      "name": "Portu tamamen up yap",
      "description": "Port 2 için yönetim ve operasyon durumlarının birlikte up olmasını doğrular.",
      "device": "lab-j9772a-01",
      "precondition": "Cihaz ve port tablosu erişilebilirdir.",
      "mutation": {
        "kind": "snmprec_values",
        "values": [
          {"semantic": "ifAdminStatus", "index": 2, "value": 1},
          {"semantic": "ifOperStatus", "index": 2, "value": 1}
        ]
      },
      "expected_snmp": [
        {"semantic": "ifAdminStatus", "index": 2, "value": 1},
        {"semantic": "ifOperStatus", "index": 2, "value": 1}
      ],
      "poll_mode": "poller",
      "expected_librenms_surface": [
        {"kind": "port", "ifIndex": 2, "ifAdminStatus": "up", "ifOperStatus": "up"}
      ],
      "expected_api_evidence": [
        {"resource": "device_ports", "selector": {"ifIndex": 2}}
      ],
      "example_questions": ["lab-j9772a-01 cihazında port 2 tamamen up mı?"],
      "expected_answer_semantics": ["port_identity", "admin_up", "oper_up"],
      "reset_state": "baseline"
    },
    {
      "id": "port-admin-up-oper-down",
      "name": "Yönetimi açık linki düşür",
      "description": "Port 2 yönetimi açık kalırken operasyon durumunun down olmasını doğrular.",
      "device": "lab-j9772a-01",
      "precondition": "Port 2 yönetim ve operasyon olarak up durumundadır.",
      "mutation": {
        "kind": "snmprec_values",
        "values": [
          {"semantic": "ifAdminStatus", "index": 2, "value": 1},
          {"semantic": "ifOperStatus", "index": 2, "value": 2}
        ]
      },
      "expected_snmp": [
        {"semantic": "ifAdminStatus", "index": 2, "value": 1},
        {"semantic": "ifOperStatus", "index": 2, "value": 2}
