    {
      "id": "uptime-reset",
      "name": "Uptime değerini sıfırla",
      "description": "Düşük uptime değeriyle yeniden başlatma benzeri durumu doğrular.",
      "device": "lab-j9772a-01",
      "precondition": "Cihazın uptime değeri 300 tick değerinden yüksektir.",
      "mutation": {
        "kind": "snmprec_values",
        "values": [
          {"semantic": "sysUpTime", "index": null, "value": 300}
        ]
      },
      "expected_snmp": [
        {"semantic": "sysUpTime", "index": null, "value": 300}
      ],
      "poll_mode": "poller",
      "expected_librenms_surface": [
        {"kind": "device", "field": "uptime", "value": 300}
      ],
      "expected_api_evidence": [
        {"resource": "device", "selector": {"hostname": "lab-j9772a-01"}}
      ],
      "example_questions": ["lab-j9772a-01 yakın zamanda yeniden başlamış görünüyor mu?"],
      "expected_answer_semantics": ["device_identity", "low_uptime", "possible_reboot"],
      "reset_state": "baseline"
    },
    {
      "id": "single-down-port",
      "name": "Tek portu down bırak",
      "description": "Dört porttan yalnız port 2'nin operasyonel olarak down olduğunu doğrular.",
      "device": "lab-j9772a-01",
      "precondition": "Cihazın 1, 2, 3 ve 4 numaralı portları SNMP tablosunda bulunur.",
      "mutation": {
        "kind": "snmprec_values",
        "values": [
          {"semantic": "ifAdminStatus", "index": 1, "value": 1},
          {"semantic": "ifOperStatus", "index": 1, "value": 1},
          {"semantic": "ifAdminStatus", "index": 2, "value": 1},
          {"semantic": "ifOperStatus", "index": 2, "value": 2},
          {"semantic": "ifAdminStatus", "index": 3, "value": 1},
          {"semantic": "ifOperStatus", "index": 3, "value": 1},
          {"semantic": "ifAdminStatus", "index": 4, "value": 1},
          {"semantic": "ifOperStatus", "index": 4, "value": 1}
        ]
      },
      "expected_snmp": [
        {"semantic": "ifAdminStatus", "index": 1, "value": 1},
        {"semantic": "ifOperStatus", "index": 1, "value": 1},
        {"semantic": "ifAdminStatus", "index": 2, "value": 1},
        {"semantic": "ifOperStatus", "index": 2, "value": 2},
        {"semantic": "ifAdminStatus", "index": 3, "value": 1},
        {"semantic": "ifOperStatus", "index": 3, "value": 1},
        {"semantic": "ifAdminStatus", "index": 4, "value": 1},
        {"semantic": "ifOperStatus", "index": 4, "value": 1}
      ],
      "poll_mode": "poller",
      "expected_librenms_surface": [
        {"kind": "port", "ifIndex": 2, "ifAdminStatus": "up", "ifOperStatus": "down"}
      ],
      "expected_api_evidence": [
        {"resource": "device_ports", "selector": {"ifIndex": 2}}
      ],
      "example_questions": ["lab-j9772a-01 cihazında diğerlerinden farklı olarak down olan port hangisi?"],
      "expected_answer_semantics": ["port_identity", "single_oper_down", "other_ports_up"],
      "reset_state": "baseline"
    },
    {
      "id": "event-producing-port-transition",
      "name": "Port geçiş olayı üret",
      "description": "Port 1 link geçişinin LibreNMS olay yüzeyinde izlenmesini doğrular.",
      "device": "lab-j9772a-01",
      "precondition": "Port 1 yönetim ve operasyon olarak up durumundadır.",
      "mutation": {
        "kind": "snmprec_values",
