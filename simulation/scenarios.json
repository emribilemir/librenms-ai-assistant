      "poll_mode": "poller",
      "expected_librenms_surface": [
        {"kind": "port", "ifIndex": 2, "ifAdminStatus": "up", "ifOperStatus": "down"}
      ],
      "expected_api_evidence": [
        {"resource": "device_ports", "selector": {"ifIndex": 2}}
      ],
      "example_questions": ["lab-j9772a-01 cihazında admin açık fakat linki down port var mı?"],
      "expected_answer_semantics": ["port_identity", "admin_up", "oper_down"],
      "reset_state": "baseline"
    },
    {
      "id": "port-down-to-up-transition",
      "name": "Down portu yeniden kaldır",
      "description": "Başlangıçta operasyonel olarak down olan port 2'nin up geçişini doğrular.",
      "device": "lab-j9772a-01",
      "precondition": "Port 2 yönetim olarak up ve operasyonel olarak down durumundadır.",
      "mutation": {
        "kind": "snmprec_values",
        "values": [
          {"semantic": "ifAdminStatus", "index": 2, "value": 1},
          {"semantic": "ifOperStatus", "index": 2, "value": 1}
        ]
      },
      "expected_snmp": [
        {"semantic": "ifAdminStatus", "index": 2, "value": 1},
        {"semantic": "ifOperStatus", "index": 2, "value": 1}
      ],
      "poll_mode": "poller",
      "expected_librenms_surface": [
        {"kind": "port", "ifIndex": 2, "ifAdminStatus": "up", "ifOperStatus": "up"}
      ],
      "expected_api_evidence": [
        {"resource": "device_ports", "selector": {"ifIndex": 2}}
      ],
      "example_questions": ["lab-j9772a-01 port 2 yeniden up oldu mu?"],
      "expected_answer_semantics": ["port_identity", "oper_transition", "oper_up"],
      "reset_state": "baseline"
    },
    {
      "id": "port-alias-change",
      "name": "Port açıklamasını değiştir",
      "description": "Port 4 açıklamasının SNMP ve LibreNMS yüzeyinde güncellenmesini doğrular.",
      "device": "lab-j9772a-01",
      "precondition": "Port 4 cihaz envanterinde bulunmaktadır.",
      "mutation": {
        "kind": "snmprec_values",
        "values": [
          {"semantic": "ifAlias", "index": 4, "value": "Demo-Uplink"}
