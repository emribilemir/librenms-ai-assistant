# Copy to .env and replace placeholders. Never commit tokens or private keys.
LAB_SSH_HOST=librenms-vm
LAB_SSH_USER=
LAB_SSH_KEY=
LAB_UTM_VM_ID=
LAB_UTM_CLI=utmctl
LAB_STOP_VM_ON_DOWN=0
LAB_REPAIR_CLOCK_SKEW=1
LAB_MAX_CLOCK_SKEW_SECONDS=60

LIBRENMS_WEB_URL=http://librenms.example
LIBRENMS_BASE_URL=http://librenms.example/api/v0
LIBRENMS_TOKEN=replace-with-read-only-token

AI_ASSISTANT_SHARED_SECRET=replace-with-32-character-shared-secret
AI_BACKEND_HOST=127.0.0.1
AI_BACKEND_PORT=8765
AI_CHAT_DB=/absolute/path/outside/the/repository/chat.sqlite3
AI_DEMO_MODE_ALLOWED=0
AI_RUNTIME_ROOT=/absolute/path/outside/the/repository/LibreNMSAiAssistant
AI_RUNTIME_PYTHON=/absolute/path/to/preprovisioned/python

# Override these only when the guest uses different service or lab paths.
LAB_PHP_FPM_SERVICE=php8.4-fpm
LAB_SNMPSIM_UNIT=librenms-snmpsim.service
LAB_DEVICES_UP=/opt/snmpsim-lab/devices-up.txt
LAB_EXPECTED_UP=8
LAB_EXPECTED_DOWN=3
