# Copy to .env and replace every placeholder before starting Compose.
TZ=Europe/Istanbul
PUID=1000
PGID=1000
RRDCACHED_PGID=1000
LIBRENMS_HTTP_PORT=8080

# Keep the default when the backend listens on all host interfaces. If it is
# bound to a specific host address, set that reachable address here.
AI_BACKEND_HOST=host.docker.internal
AI_BACKEND_PORT=8765

MYSQL_DATABASE=librenms
MYSQL_USER=librenms
MYSQL_PASSWORD=replace-with-a-long-random-password
LIBRENMS_APP_KEY=copy-APP_KEY-from-the-source-LibreNMS-env

# Optional image overrides.
MARIADB_IMAGE=mariadb:11.8
REDIS_IMAGE=redis:7.2-alpine
RRDCACHED_IMAGE=crazymax/rrdcached:latest
LIBRENMS_IMAGE=librenms/librenms:latest
LOCAL_LIBRENMS_IMAGE=librenms-ai-assistant:local
NGINX_IMAGE=nginx:alpine
